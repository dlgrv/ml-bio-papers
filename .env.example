# Local MT server (llama.cpp, OpenAI-compatible). .env is gitignored.
# Primary names (preferred):
LLM_API_KEY=local
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Hy-MT2-30B-A3B-Q8_0
LLM_TEMPERATURE=0.2

# Aliases still accepted by translate/llm/client.py (HTLB heritage):
HTLB_LLM_API_KEY=local
HTLB_LLM_BASE_URL=http://127.0.0.1:8080/v1
HTLB_LLM_MODEL=Hy-MT2-30B-A3B-Q8_0
HTLB_LLM_TEMPERATURE=0.2
